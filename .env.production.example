# Production settings for Vercel — set these in Vercel → Project → Settings → Environment Variables
# (scope: Production). Never commit real values.

# --- Database (Neon via Vercel Marketplace sets the first two for you) ---
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"
# Direct connection — used only by `prisma migrate deploy` during the production build
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Ticket photos (Vercel Blob, private store — set automatically when you connect the store) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- App ---
SHOW_DEMO_ACCOUNTS=false     # must stay false in production
DISPLAY_TZ=Asia/Bangkok
APPROVAL_LIMIT=50000
REORDER_FACTOR=3
DEFAULT_THEME=light
# COOKIE_SECURE — leave unset: Vercel is always HTTPS, cookies are Secure in production
