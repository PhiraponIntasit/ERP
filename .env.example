# PostgreSQL connection
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"

# Where uploaded ticket photos are stored (outside /public — served through an authenticated route)
UPLOAD_DIR="./storage/uploads"
# When set (e.g. on Vercel), photos go to a private Vercel Blob store instead of UPLOAD_DIR
# BLOB_READ_WRITE_TOKEN=

# Business rules
APPROVAL_LIMIT=50000        # ฿ incl. VAT — above this a PR needs Manager + Executive
REORDER_FACTOR=3            # suggested order qty = reorder point × factor − on hand
DEFAULT_THEME=light         # light | dark — for users who never toggled

# Show the one-click demo accounts on the login page. Turn OFF in production.
SHOW_DEMO_ACCOUNTS=true

# Time zone used for all displayed dates and the dashboard's day buckets
DISPLAY_TZ=Asia/Bangkok

# Session cookies are Secure (HTTPS-only) in production. Set to false ONLY if you serve over plain HTTP on an intranet.
# COOKIE_SECURE=true

# ── Email (for "ลืมรหัสผ่าน") ──────────────────────────────────────────────
# Public base URL used in emailed links. REQUIRED in production (never derived from the request).
APP_URL="http://localhost:3000"
# Any SMTP server: Gmail/Workspace (smtp.gmail.com:587 + app password), Office 365 (smtp.office365.com:587),
# Resend (smtp.resend.com:465, user "resend"), or your company mail server.
# Leave SMTP_HOST empty in development to print emails to the server console instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="IT Products Store <no-reply@example.com>"
# Without SMTP, emails (password reset, ticket notifications) are saved here as JSON instead of sent.
# Defaults to ./storage/outbox in development; leave unset in production.
# MAIL_OUTBOX_DIR=./storage/outbox

# ── Payments (PromptPay QR, demo mode) ──────────────────────────────────────
# HMAC key that signs payment webhooks (≥ 16 chars). REQUIRED in production — generate with `openssl rand -hex 32`
# and keep it only in Vercel env. Development falls back to a fixed dev-only key when unset.
PAYMENT_WEBHOOK_SECRET=""
# Vercel Cron sends this as "Authorization: Bearer …" to /api/cron/expire-orders. Generate like the above.
CRON_SECRET=""
# Demo PromptPay ID shown in the QR — fictitious by default (13 zeros) so no real transfer can go through.
# PROMPTPAY_ID=0000000000000
# Minutes a customer has to pay before the order expires and held stock is released.
# PAYMENT_EXPIRE_MINUTES=15
# Set to false to hide the "simulate transfer" button (e.g. for a public demo).
# PAYMENT_DEMO_SIMULATE=true
