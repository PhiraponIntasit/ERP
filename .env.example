# PostgreSQL connection
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp?schema=public"

# Where uploaded ticket photos are stored (outside /public — served through an authenticated route)
UPLOAD_DIR="./storage/uploads"

# Business rules
APPROVAL_LIMIT=50000        # ฿ incl. VAT — above this a PR needs Manager + Executive
REORDER_FACTOR=3            # suggested order qty = reorder point × factor − on hand
DEFAULT_THEME=light         # light | dark — for users who never toggled

# Show the one-click demo accounts on the login page. Turn OFF in production.
SHOW_DEMO_ACCOUNTS=true

# Time zone used for all displayed dates and the dashboard's day buckets
DISPLAY_TZ=Asia/Bangkok

# Session cookies are Secure (HTTPS-only) in production. Set to false ONLY if you serve over plain HTTP on an intranet.
# COOKIE_SECURE=true
