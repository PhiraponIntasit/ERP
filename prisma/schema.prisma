generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Login account. `perms` holds module keys (see src/lib/domain.ts MODULES);
/// it starts as the role default and can be adjusted per person by an Admin.
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  role         String
  perms        String[]
  active       Boolean   @default(true)
  empId        String?   @unique
  employee     Employee? @relation(fields: [empId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  sessions        Session[]
  passwordResets  PasswordReset[]
  ticketsOpened   Ticket[]          @relation("TicketRequester")
  ticketsAssigned Ticket[]          @relation("TicketAssignee")
  prsRequested    PurchaseRequest[] @relation("PRRequester")
  prsApproved1    PurchaseRequest[] @relation("PRApprover1")
  prsApproved     PurchaseRequest[] @relation("PRApprover")
}

model Session {
  /// sha256 of the cookie token — the raw token is never stored
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One-time "forgot password" link sent by email. Only the sha256 of the token is stored.
model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, createdAt])
}

model Employee {
  id       String  @id // EMP-0001
  name     String
  position String  @default("")
  dept     String
  email    String  @default("")
  phone    String  @default("")
  user     User?
  assets   Asset[]
}

model Asset {
  tag         String       @id // NB-0101
  type        String
  model       String
  serial      String       @default("")
  warrantyEnd DateTime?    @db.Date
  holderId    String?
  holder      Employee?    @relation(fields: [holderId], references: [id], onDelete: SetNull)
  history     AssetEvent[]
  createdAt   DateTime     @default(now())

  @@index([holderId])
}

model AssetEvent {
  id       String   @id @default(cuid())
  assetTag String
  asset    Asset    @relation(fields: [assetTag], references: [tag], onDelete: Cascade)
  t        DateTime @default(now())
  text     String
  by       String

  @@index([assetTag, t])
}

model InventoryItem {
  sku   String      @id
  name  String
  cat   String
  unit  String
  qty   Int
  min   Int
  price Decimal     @db.Decimal(12, 2)
  loc   String
  moves StockMove[]
}

model StockMove {
  id   String        @id @default(cuid())
  t    DateTime      @default(now())
  sku  String
  item InventoryItem @relation(fields: [sku], references: [sku])
  type String // in | out
  qty  Int
  ref  String
  by   String

  @@index([t])
}

model Ticket {
  id          String    @id // TCK-1050
  title       String
  cat         String
  urgency     String // low | medium | high | critical
  assetTag    String    @default("")
  desc        String
  requesterId String
  requester   User      @relation("TicketRequester", fields: [requesterId], references: [id])
  created     DateTime  @default(now())
  status      String // new | assigned | progress | waiting | resolved | closed
  assigneeId  String?
  assignee    User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  resolvedAt  DateTime?
  closedAt    DateTime?
  rating      Int?
  ratingNote  String    @default("")

  images  TicketImage[]
  parts   TicketPart[]
  history TicketEvent[]

  @@index([status])
  @@index([requesterId])
  @@index([assigneeId])
}

model TicketImage {
  id       String       @id @default(cuid())
  ticketId String
  ticket   Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  file     String // file name inside UPLOAD_DIR
  mime     String
  name     String
  size     Int
  ord      Int
  kind     String       @default("report") // report = from the requester | work = from the technician
  eventId  String? // the status update a work photo was attached to
  event    TicketEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model TicketPart {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sku      String
  name     String
  qty      Int

  @@id([ticketId, sku])
}

model TicketEvent {
  id       String        @id @default(cuid())
  ticketId String
  ticket   Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  t        DateTime      @default(now())
  text     String
  by       String
  images   TicketImage[]

  @@index([ticketId, t])
}

model PurchaseRequest {
  id          String    @id // PR-2026-0015
  date        DateTime  @default(now())
  requesterId String
  requester   User      @relation("PRRequester", fields: [requesterId], references: [id])
  vendor      String
  note        String    @default("")
  /// pending | pending_exec | approved | rejected | received
  status      String
  approver1Id String?
  approver1   User?     @relation("PRApprover1", fields: [approver1Id], references: [id])
  decided1    DateTime?
  approverId  String?
  approver    User?     @relation("PRApprover", fields: [approverId], references: [id])
  decided     DateTime?
  reason      String    @default("")
  received    DateTime?
  lines       PRLine[]

  @@index([status])
}

model PRLine {
  id    String          @id @default(cuid())
  prId  String
  pr    PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  ord   Int
  sku   String
  name  String
  unit  String
  qty   Int
  price Decimal         @db.Decimal(12, 2)

  @@index([prId])
}

/// Append-only. UPDATE / DELETE / TRUNCATE are rejected by a database trigger
/// (see the init migration), so not even an Admin with DB credentials used by
/// the app can rewrite history.
model AuditLog {
  id     BigInt   @id @default(autoincrement())
  t      DateTime @default(now())
  userId String?
  by     String
  role   String
  cat    String
  action String
  target String   @default("")
  detail String   @default("")

  @@index([t])
  @@index([cat])
}

/// Document number sequences (tck, pr, emp)
model Counter {
  key   String @id
  value Int
}
